{
  "id": "duotone",
  "name": "双色调",
  "enabled": false,
  "uniforms": [
    { "id": "uDark",  "label": "暗部颜色", "type": "color", "color": "#1A1033" },
    { "id": "uLight", "label": "亮部颜色", "type": "color", "color": "#FFD9A0" },
    { "id": "uMix",   "label": "混合程度", "type": "float", "min": 0.0, "max": 1.0, "def": 1.0 }
  ],
  "code": "float l = dot(color, vec3(0.2126, 0.7152, 0.0722));\ncolor = mix(color, mix(uDark, uLight, l), uMix);"
}
